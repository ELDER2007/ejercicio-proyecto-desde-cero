# Copia este archivo a .env y cambia los valores. NUNCA subas .env a Git.
# Todos los valores de abajo son ejemplos de desarrollo, no secretos reales.

# --- Entorno ---
APP_ENV=development            # development | testing | staging | production
LOG_LEVEL=INFO

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=tallerya
POSTGRES_PASSWORD=cambia_esto_en_tu_.env
POSTGRES_DB=tallerya
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---
FRONTEND_PORT=3000

# --- Seguridad ---
# Genera uno propio: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia_esto_por_un_valor_largo_y_aleatorio

# --- Pagos (proveedor real: pendiente de decisión del cliente) ---
PAYMENT_PROVIDER=fake
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me
FRONTEND_URL=http://localhost:3000

# --- Observabilidad (opcional; ver docker-compose.yml, perfil "observability") ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Producción (obligatorio fuera de desarrollo) ---
# COOKIE_SECURE=true
# TRUSTED_PROXY_HOPS=1   # nº de proxies de confianza delante del backend

# --- Despliegue (Render) --- ver docs/despliegue.md
# DATABASE_URL=postgres://usuario:clave@host:5432/db   # sustituye a POSTGRES_*; Render la entrega sola
# ALLOW_FAKE_PAYMENTS=true       # SOLO demo: pagos simulados fuera de desarrollo
# EMBEDDED_WORKER=true           # worker dentro de la API (sin pagar un worker aparte)
# BOOTSTRAP_OWNER_EMAIL=         # crea el primer propietario si no existe
# BOOTSTRAP_OWNER_PASSWORD=
# SEED_DEMO=true                 # carga cursos de demostración si la BD está vacía

# --- Asistente de IA (opcional) ---
# ANTHROPIC_API_KEY=sk-ant-...          # clave de console.anthropic.com; sin ella el asistente está desactivado
# ASSISTANT_MODEL=claude-opus-5-5        # o claude-sonnet-5-5 / claude-haiku-5-5 (más barato)
# ASSISTANT_DAILY_LIMIT=300              # tope global de mensajes al día (control de coste)
